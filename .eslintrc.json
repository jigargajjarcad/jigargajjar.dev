{
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/recommended"],
  "plugins": ["jsx-a11y"],
  "rules": {
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      { "tags": [], "roles": ["tabpanel", "region"], "allowExpressionValues": true }
    ]
  },
  "ignorePatterns": ["node_modules", ".next", "src/styles/tokens.css"]
}
